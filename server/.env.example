# ---------------------------------------------------------------------------
# API Solar Costa — copie para .env e preencha. NUNCA comite o .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Conexao com o PostgreSQL da VPS.
# Use o papel solarcosta_app (DML), nao o postgres.
DATABASE_URL=postgres://solarcosta_app:SENHA@38.225.221.230:5434/SolarCosta
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Conexao usada SO pelo `npm run migrate`, com o papel solarcosta_migrator
# (crie com database/03_papel_migracao.sql, como superusuario).
#
# O solarcosta_app do DATABASE_URL acima NAO tem DDL, de proposito: assim o
# processo que atende requisicao HTTP nunca segura uma conexao capaz de CREATE,
# ALTER ou DROP. Sem esta variavel o `npm run migrate` para em
# "permission denied for schema public" - e no deploy isso impede a API de subir,
# porque o Dockerfile roda `npm run migrate && npm start`.
MIGRATION_DATABASE_URL=postgres://solarcosta_migrator:SENHA@38.225.221.230:5434/SolarCosta

# Gere cada segredo com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Precisam ser DIFERENTES entre si e ter no minimo 32 caracteres.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-48-bytes
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-de-48-bytes

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DIAS=30

# Origens do front liberadas no CORS, separadas por virgula.
CORS_ORIGINS=http://localhost:3000

# Google Maps Platform - chave de SERVIDOR, usada pela Solar API
# (buildingInsights), pela Geocoding API e pela Maps Static API (o recorte de
# satelite que aparece no card do telhado).
# Crie no Cloud Console, restrinja por IP da VPS e libere ESSAS TRES APIs.
# Deixe em branco para desligar a busca de telhado por satelite.
GOOGLE_MAPS_SERVER_KEY=

# Google Maps Platform - chave de BROWSER, usada pelo editor de telhado em
# tela cheia (Maps JavaScript API). E OUTRA chave: esta roda no navegador, e a
# de cima esta travada por IP da VPS.
# Restrinja por REFERRER HTTP (https://SEU-DOMINIO/*) e libere SO a Maps
# JavaScript API. Defina tambem um teto de cota: os tiles sao cobrados direto
# do navegador, fora do alcance do cache da nossa API.
# Deixe em branco para desligar so o editor em tela cheia.
GOOGLE_MAPS_BROWSER_KEY=

# Rotina diaria (boletos vencidos, obras atrasadas).
# Desligue com false se estiver usando pg_cron no banco.
SCHEDULER_ATIVO=true
SCHEDULER_HORA=3
SCHEDULER_MINUTO=10

# URL publica da aplicacao, com protocolo e sem barra final.
# Ex: https://crm.solarcosta.com.br
# Obrigatoria quando UAZAPI_ADMIN_TOKEN estiver preenchida: e por ela que a
# uazapi sabe para onde mandar as mensagens recebidas (webhook) e que o link da
# proposta enviada ao cliente e montado. Nao da para deduzir do request: em
# desenvolvimento isso mandaria "http://localhost:4000/p/..." para um cliente.
APP_URL=

# ---------------------------------------------------------------------------
# WhatsApp - uazapi (uazapiGO). Deixe UAZAPI_ADMIN_TOKEN em branco para
# desligar a integracao inteira; a API sobe normal sem ela.
# ---------------------------------------------------------------------------

# Host do SEU container uazapi, sem barra final.
# O free.uazapi.com serve para testar o fluxo do QR e nada mais: ele derruba e
# APAGA a instancia depois de 1 hora.
UAZAPI_URL=

# Token de ADMINISTRADOR do container (header `admintoken`).
# So cria e lista instancias - todo o resto usa o token da instancia, que nasce
# do /instance/create e fica cifrado no banco.
# ATENCAO: e um token raiz. GET /instance/all devolve o token de TODAS as
# instancias do container em texto puro.
UAZAPI_ADMIN_TOKEN=

# Chave que cifra o token da instancia em SolarCosta_WhatsAppInstancia.
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Separada do JWT_SECRET de proposito: trocar o segredo do JWT e rotina e so
# derruba as sessoes. Se ele tambem cifrasse este token, a mesma troca
# desconectaria o WhatsApp da empresa sem aviso.
WHATSAPP_CRIPTO_KEY=
